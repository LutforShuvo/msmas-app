# Copy this file to .env.local for local testing, or paste these values
# into Vercel's Environment Variables when deploying.

# The full contents of your service-account JSON key file, as ONE line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# The ID from your Sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# --- Sign-in (Google OAuth) ---
# These are DIFFERENT from the service account above — this is a separate
# "OAuth client" credential from Google Cloud, used for people signing in,
# not for the app talking to your Sheet. See README for setup steps.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# NextAuth's own settings.
# NEXTAUTH_SECRET: any long random string — used to encrypt sessions.
#   Generate one with: openssl rand -base64 32
#   (or just mash the keyboard for 40+ random characters, it just needs to be unpredictable)
NEXTAUTH_SECRET=replace-with-a-long-random-string
# NEXTAUTH_URL: your app's own URL. For local testing:
NEXTAUTH_URL=http://localhost:3000
